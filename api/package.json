{
  "name": "klyro-api",
  "version": "0.1.0",
  "private": true,
  "description": "Klyro planner API: turns an instruction plus file metadata into a plan. Never receives file contents.",
  "license": "AGPL-3.0-or-later",
  "author": "Prakhar Pandey",
  "homepage": "https://github.com/Prakharpan-dey/Klyro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prakharpan-dey/Klyro.git"
  },
  "bugs": {
    "url": "https://github.com/Prakharpan-dey/Klyro/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env scripts/dev-server.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "oxlint src scripts",
    "format": "prettier --write .",
    "build": "npm run bundle && sam build",
    "deploy": "sam deploy --guided",
    "bundle": "esbuild src/plan.ts --bundle --platform=node --format=esm --target=es2022 --minify --outfile=dist/plan.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\""
  },
  "type": "module",
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-provider-node": "^3.972.83",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "esbuild": "0.28.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.13.5",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  }
}
