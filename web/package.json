{
  "name": "klyro-web",
  "version": "0.1.0",
  "private": true,
  "description": "Klyro web app: 56 image, PDF and video tools that run entirely in the browser.",
  "license": "AGPL-3.0-or-later",
  "author": "Prakhar Pandey",
  "homepage": "https://github.com/Prakharpan-dey/Klyro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prakharpan-dey/Klyro.git"
  },
  "bugs": {
    "url": "https://github.com/Prakharpan-dey/Klyro/issues"
  },
  "keywords": [
    "pdf",
    "image",
    "video",
    "privacy",
    "local-first",
    "webassembly",
    "webcodecs",
    "ocr"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "jszip": "^3.10.2",
    "mediabunny": "^1.58.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
